# GPU 版 Dockerfile - 适用于 NVIDIA 显卡的 Windows/Linux 机器
# 基于 PyTorch 官方 CUDA 镜像，已内置 Python 3.10 + torch + CUDA 11.8
FROM pytorch/pytorch:2.1.0-cuda11.8-cudnn8-runtime

WORKDIR /app

# 系统依赖（OpenCV 运行需要）
RUN apt-get update && apt-get install -y \
    libgl1 libglib2.0-0 libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# 安装其他 Python 依赖（torch 已内置，不重复装）
RUN pip install --no-cache-dir \
    flask flask-jwt-extended waitress pymysql pillow requests schedule opencv-python-headless ultralytics \
    -i https://pypi.tuna.tsinghua.edu.cn/simple

COPY . .

EXPOSE 8080

CMD ["waitress-serve", "--host=0.0.0.0", "--port=8080", "--threads=8", "mainyolo1:app"]
